# ---------------------------------------------------------------------------
# Scoutly backend configuration.  Copy this file to `.env` and fill in a key
# only if you want LIVE LLM output.  With no key (or MOCK_LLM=true) every LLM
# call returns realistic canned JSON, so the demo never breaks.
# ---------------------------------------------------------------------------

# Which LLM provider to use: `openai` (any OpenAI-compatible chat endpoint),
# `anthropic`, or `mock`.
LLM_PROVIDER=openai

# API key for the provider above.  Leave blank to force MOCK MODE.
LLM_API_KEY=

# Model id understood by the provider.
#   OpenAI      gpt-4o-mini / gpt-4.1-mini
#   Anthropic   claude-3-5-haiku-latest      (set LLM_PROVIDER=anthropic)
#   OpenRouter  openai/gpt-4o-mini           (set LLM_BASE_URL below)
LLM_MODEL=gpt-4o-mini

# Base URL for OpenAI-compatible endpoints.  Blank = https://api.openai.com/v1.
# For OpenRouter use: https://openrouter.ai/api/v1
# NOTE: OpenRouter `:free` models are usually reasoning models and/or heavily
# rate-limited - they can burn the token budget "thinking" and return empty
# content. Use a paid/non-reasoning model for live demos.
LLM_BASE_URL=

# Force canned JSON even when a key is present.  Keep this true for a stage
# demo; set it to false (with a working key) to show live generation.
MOCK_LLM=true

# Per-call timeout in seconds.  Every call falls back to rules on timeout.
LLM_TIMEOUT_SECONDS=10

# SQLite file.  Relative paths resolve against the `backend/` directory.
DATABASE_URL=sqlite:///./scoutly.db

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local embedding model, and `auto` | `hashing`.
# `hashing` skips torch entirely for a fast cold start (lower semantic quality).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BACKEND=auto
